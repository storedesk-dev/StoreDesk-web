# Copy to .env.local (never commit .env.local).
#
# `npm run dev:local` needs none of this: it starts a throwaway in-memory
# MongoDB, seeds sample data, and turns Cloudflare and e-mail off.

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB (Atlas). Setup-key activation uses transactions, which need a
# replica set; Atlas has one on every tier.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/storedesk?retryWrites=true&w=majority&appName=StoreDesk

# The first staff login. Signing in at /admin-gate with exactly these creates
# the internal admin; after that the stored (hashed) password is what counts.
# ADMIN_PASSWORD is accepted as an older name for SUPPORT_ADMIN_PASSWORD.
SUPPORT_ADMIN_EMAIL=
SUPPORT_ADMIN_PASSWORD=

# Encrypts the Verifone Commander password held in the database
# (AES-256-GCM). At least 32 characters. Without it the register address and
# username still sync, but a register password cannot be stored.
STORE_SECRET_KEY=

# ── Cloudflare tunnels: how phones reach each store ─────────────────────────
# Unset: new stores show the tunnel as "not configured" and the store page
# offers Retry once these are set.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_DOMAIN=tunnels.storedesk.net

# ── E-mail (setup keys, invitations) through Resend ─────────────────────────
# Unset: setup keys and invitation codes are only shown to the admin, once.
RESEND_API_KEY=
SETUP_EMAIL_FROM="StoreDesk <setup@storedesk.net>"

# ── Google Sheets: StoreDesk's one service account ──────────────────────────
# The service account's downloaded key file, as raw JSON or base64. Store
# owners share their sheet with its client_email. The key and its access
# tokens never leave the control plane: store servers use the store-scoped
# proxy /api/v1/edge/google/sheets/*. Unset: the sheet check and the proxy
# answer 503 GOOGLE_NOT_CONFIGURED.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── The lottery cloud: Supabase ─────────────────────────────────────────────
# Project "storedesk", ref hichhjtsooerdmzjsmhm, us-west-2 (Free).
#
# Four values, and only two of them are secret. Unset: every lottery PC stays
# local with SQLite as its only source of truth, the token route answers 503
# CLOUD_UNAVAILABLE, and each PC switches its link off and says nothing — which
# is exactly how the app behaved before there was a cloud at all. So this is the
# switch: setting these four turns the cloud on for every lottery store.
#
# Public, and safe in a client. A store PC does not carry them: it asks
# /api/v1/edge/lottery/token and is told, so rotating a key or moving projects
# is one deployment instead of a visit to every counter.
SUPABASE_URL=https://hichhjtsooerdmzjsmhm.supabase.co
# The modern publishable key (sb_publishable_…). It reads nothing on its own —
# the pgTAP suite asserts exactly that. The legacy anon key also works.
SUPABASE_ANON_KEY=

# SECRET. Signs every token the control plane mints, and this is the only module
# that touches it (lib/supabase-token.ts). It can emit one Postgres role,
# "authenticated", so a mis-minted token reads one store rather than everything.
# Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret.
# Must be at least 32 characters or minting refuses and answers 503.
SUPABASE_JWT_SECRET=

# SECRET, and the most dangerous value here: it bypasses RLS entirely. Read in
# lib/supabase-admin.ts and nowhere else — never sent to a store, never put in a
# response, never logged. It applies the projection and reads a store's health.
# Supabase dashboard → Project Settings → API keys → service_role (or the new
# sb_secret_… key). Never put it in NEXT_PUBLIC_ anything.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# The admin console's origin. Admin API changes are refused unless they come
# from it (Origin header or Sec-Fetch-Site: same-origin). Unset: the origin
# the request was made to.
# ADMIN_ORIGIN=https://storedesk.net
# Canonical site URL for metadata (defaults to https://storedesk.net).
# NEXT_PUBLIC_SITE_URL=https://storedesk.net
# Issuer claim of the legacy client session tokens (no app uses them now).
# CONTROL_PLANE_ISSUER=storedesk-web
