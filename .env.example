# Copy to .env.local (never commit .env.local)

# Required for Atlas license registry (admin + /api/stores).
# Without this, stores use in-memory mode (lost on restart).
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/storedesk?retryWrites=true&w=majority&appName=StoreDesk

# Optional. Admin gate password.
# If omitted, the password is taken from MONGODB_URI (the DB user password).
# ADMIN_PASSWORD=

# Cloudflare API Configuration for Automated Tunnel Provisioning
CLOUDFLARE_API_TOKEN=cfut_YOUR_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_TUNNEL_DOMAIN=tunnels.storedesk.net

# Encrypts store secrets held in Atlas — currently the Verifone Commander
# password, so an operator can set the register credential from the control
# plane and have it reach the store. At least 32 characters.
# Without it, address and username still sync; the password cannot be stored.
STORE_SECRET_KEY=

# Signs client session tokens' issuer claim. Must match CONTROL_PLANE_ISSUER
# on the Worker.
CONTROL_PLANE_ISSUER=storedesk-web
